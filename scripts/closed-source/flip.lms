# Public-tree staging and owner-gated private-mirror/public-in-place flip.
# Default mode is read-only. --stage writes only /home/mma/staging; --apply
# needs an explicit owner flag/file entry and the protected token file checked by the helper.

let products = ["lmdraw", "lmvideo", "lmaudio", "lmoffice", "lmcad", "lmmagnum", "lmfilament", "lmimg", "lmpdf"];
let product = "";
let mode = "--dry-run";
let owner_flag = false;
let first_release_tag = "";
let refresh_stage = false;
for (arg in ARGV) {
  if (arg == "--dry-run" || arg == "--stage" || arg == "--apply") { mode = arg; }
  else if (arg == "--refresh-stage") { mode = "--stage"; refresh_stage = true; }
  else if (arg == "--i-have-owner-approval") { owner_flag = true; }
  else if (starts_with(arg, "--first-release-tag=")) { first_release_tag = substr(arg, 20); }
  else if (starts_with(arg, "--")) { error("unknown option: " + arg); }
  else if (product == "") { product = arg; }
  else { error("unexpected argument: " + arg); }
}
assert(product != "", "usage: lmscript scripts/closed-source/flip.lms PRODUCT [--dry-run | --stage | --apply --i-have-owner-approval --first-release-tag=vX.Y.Z]");
assert(contains(products, product), "product is outside the final closed-source scope: " + product);
if (mode == "--apply") {
  assert(owner_flag, "REFUSED: --apply requires explicit --i-have-owner-approval");
  let home = getenv("HOME", "/home/mma");
  let approval = path_join(home, "tools", "closed-source-approved.txt");
  assert(file_exists(approval), "REFUSED: approval file missing: " + approval);
  assert(contains(read_lines(approval), product), "REFUSED: approval file must list " + product);
  assert(regex_test(first_release_tag, "^v[0-9]+\\.[0-9]+\\.[0-9]+$"), "REFUSED: --apply requires --first-release-tag=vMAJOR.MINOR.PATCH");
}
let helper = "/home/mma/repos/dsl/lmgallery/scripts/closed-source/peer-flip.py";
let command = ["python3", helper, mode, "--product", product];
if (first_release_tag != "") { push(command, "--first-release-tag"); push(command, first_release_tag); }
if (refresh_stage) { push(command, "--refresh"); }
let result = system(command, 3600000);
print(result.stdout);
if (result.code != 0) { error("peer flip tool refused or failed: " + result.stderr); }
