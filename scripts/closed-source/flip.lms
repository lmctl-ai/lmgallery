# lmaudio-only migration runner. Default mode is read-only dry-run.
# --apply is gated by ~/tools/closed-source-approved.txt and this script has
# no delete_repo call, force-push, or source-history rewrite.

fn checked(argv) {
  let result = system(argv, 300000);
  assert(result.code == 0, "command failed: " + cmd_render(argv) + "\n" + result.stderr + result.stdout);
  return result;
}

fn public_file(path) {
  let base = basename(path);
  if (path == "README.md" || starts_with(path, "docs/") || starts_with(path, "examples/")) { return true; }
  if (starts_with(path, "images/") || starts_with(path, "licenses/")) { return true; }
  if (starts_with(base, "THIRD_PARTY_NOTICES") || starts_with(base, "COPYING") || starts_with(base, "NOTICE")) { return true; }
  if (starts_with(path, "assets/fonts/") && (starts_with(base, "LICENSE") || starts_with(base, "OFL"))) { return true; }
  return false;
}

fn source_reference_pattern() {
  return "\\]\\([^)]*(src|cpp|schema|tests|scripts|durable-memory|[.]github)/[^)]*\\)|https?://github[.]com/[^/]+/[^/]+/(blob|tree)/[^/]+/(src|cpp|schema|tests|scripts|durable-memory|[.]github)/";
}

fn sanitize_readme(input) {
  let output = input;
  output = replace_all(output, "actions/workflows/ci.yml", "actions/workflows/public-ci.yml");
  output = replace_all(output, "](LICENSE)", "](LICENSE-examples)");
  output = replace_all(output, "[schema/lmaudio.dsl.json](schema/lmaudio.dsl.json)", "`lmaudio --dsl-schema`");
  output = replace_all(output, "How it is built and why: [durable-memory/](durable-memory/index.md).", "");
  let known_answers = index_of(output, "## Known answers it is tested against");
  let honest_limits = index_of(output, "## Honest limits", known_answers);
  if (known_answers >= 0 && honest_limits > known_answers) { output = slice(output, 0, known_answers) + slice(output, honest_limits); }
  let build_section = index_of(output, "## Build from source");
  if (build_section >= 0) {
    let license_section = index_of(output, "## License", build_section);
    assert(license_section > build_section, "README source build section is missing its license section boundary");
    let public_license = "## License\n\nThe public examples and documentation are MIT under [LICENSE-examples](LICENSE-examples). The v0.2.1 release keeps the MIT `LICENSE` asset it was published with. Future proprietary binary releases are intended to use the draft [LICENSE-binaries](LICENSE-binaries), pending final owner approval. Third-party terms are in [THIRD_PARTY_NOTICES](THIRD_PARTY_NOTICES).\n";
    output = slice(output, 0, build_section) + public_license;
  }
  let public_note = "\n> The public peer contains demos, docs, examples, and release assets. Private implementation source is maintained in `lmctlhq/lmaudio`. Historical v0.2.1 release terms remain MIT; future binary terms are tracked separately in `LICENSE-binaries`.\n";
  output = replace(output, "# lmaudio\n", "# lmaudio\n" + public_note);
  return output;
}

let product = "";
let apply_requested = false;
let owner_flag = false;
for (arg in ARGV) {
  if (arg == "--apply") { apply_requested = true; }
  else if (arg == "--dry-run") { }
  else if (arg == "--i-have-owner-approval") { owner_flag = true; }
  else if (starts_with(arg, "--")) { error("unknown option: " + arg); }
  else if (product == "") { product = arg; }
  else { error("unexpected argument: " + arg); }
}
assert(product == "lmaudio", "this pilot runner is enabled only for lmaudio");
assert(!(apply_requested && contains(ARGV, "--dry-run")), "choose either --dry-run or --apply");

let source = "/home/mma/repos/dsl/lmaudio";
let old_public = "lmctl-ai/lmaudio";
let private_repo = "lmctlhq/lmaudio";
let public_repo = "lmctl-ai/lmaudio";
let source_public_url = "https://github.com/lmctl-ai/lmaudio.git";
let source_private_url = "https://github.com/lmctlhq/lmaudio.git";
let public_url = "https://github.com/lmctl-ai/lmaudio.git";
let stage_root = "/home/mma/staging/closed-source";
let release_stage = path_join(stage_root, "lmaudio-release");
let public_stage = path_join(stage_root, "lmaudio-public");
let public_clone = "/home/mma/repos/dsl/lmaudio-public";
let approval_path = path_join(getenv("HOME", "/home/mma"), "tools", "closed-source-approved.txt");

let local_origin = trim(checked(["git", "-C", source, "remote", "get-url", "origin"]).stdout);
let local_head = trim(checked(["git", "-C", source, "rev-parse", "HEAD"]).stdout);
let local_status = trim(checked(["git", "-C", source, "status", "--porcelain", "--untracked-files=all"]).stdout);
let remote_head_output = trim(checked(["git", "ls-remote", source_public_url, "refs/heads/main"]).stdout);
let remote_head = first(split_regex(remote_head_output, "\\s+"));
let repo_meta = json_parse(checked(["gh", "api", "repos/" + old_public]).stdout);
let private_target_probe = system(["gh", "api", "repos/" + private_repo]);
let private_target_available = private_target_probe.code != 0 && regex_test(lower(private_target_probe.stdout + private_target_probe.stderr), "not found|404");
let runs = json_parse(checked(["gh", "run", "list", "-R", old_public, "-L", "1", "--json", "status,conclusion,displayTitle,headSha,url"]).stdout);
assert(len(runs) > 0, "no CI run found for " + old_public);
let latest_run = first(runs);
let release_rows = json_parse(checked(["gh", "release", "list", "-R", old_public, "-L", "1", "--json", "tagName,name,isLatest"]).stdout);
assert(len(release_rows) > 0, "no release found for " + old_public);
let latest_release_row = first(release_rows);
let release_tag = getstr(latest_release_row, "tagName");
let release = json_parse(checked(["gh", "release", "view", release_tag, "-R", old_public, "--json", "tagName,name,body,targetCommitish,publishedAt,assets,url"]).stdout);
let release_assets = getlist(release, "assets");
let release_asset_names = [];
for (asset in release_assets) { push(release_asset_names, getstr(asset, "name")); }
release_asset_names = sort(release_asset_names);
let expected_assets = sort(["LICENSE", "THIRD_PARTY_NOTICES", "SHA256SUMS", "lmaudio-linux-x64", "lmaudio-linux-arm64", "lmaudio-macos-arm64", "lmaudio-macos-x64", "lmaudio-windows-x64.exe"]);

let runner_state = checked(["lmctl", "running"]).stdout;
let in_running = true;
let audio_agent_active = false;
for (line in lines(runner_state)) {
  let lower_line = lower(trim(line));
  if (starts_with(lower_line, "idle,")) { in_running = false; }
  if (in_running && starts_with(lower_line, "lmaudio.")) { audio_agent_active = true; }
}

let latest_ci_green = getstr(latest_run, "status") == "completed" && getstr(latest_run, "conclusion") == "success" && getstr(latest_run, "headSha") == remote_head;
let source_clean = local_status == "";
let source_pushed = local_head == remote_head;
let source_identity = local_origin == source_public_url;
let repo_is_public = getstr(repo_meta, "visibility") == "public";
let release_complete = getstr(release, "tagName") == release_tag && join(release_asset_names, "\n") == join(expected_assets, "\n");
let local_paths_clear = system(["test", "-e", release_stage]).code != 0 && system(["test", "-e", public_stage]).code != 0 && system(["test", "-e", public_clone]).code != 0;
let rate = json_parse(checked(["gh", "api", "rate_limit"]).stdout);
let api_remaining = getnum(rate, ["resources", "core", "remaining"], 0);
let consumer_scan = system(["rg", "--no-messages", "-n", "lmctl-ai/lmaudio@v?0\\.[0-9]+\\.[0-9]+", "/home/mma/repos/dsl", "/home/mma/repos/lmctlhq"]);
let consumer_matches = [];
if (consumer_scan.code == 0) { consumer_matches = lines(trim(consumer_scan.stdout)); }
let old_consumer_pins = [];
let release_version = replace(release_tag, "v", "");
for (match in consumer_matches) { if (!contains(match, "@v" + release_version)) { push(old_consumer_pins, match); } }

let source_files = lines(checked(["git", "-C", source, "ls-files"]).stdout);
let public_paths = [];
for (path in source_files) { if (public_file(path)) { push(public_paths, path); } }
let preview_readme = sanitize_readme(read_file(path_join(source, "README.md")));
let raw_count = 0;
let raw_good = 0;
let raw_bad = [];
for (line in lines(preview_readme)) {
  if (contains(lower(line), "lmctl autorun")) {
    for (match in regex_find_all(line, "https://raw\\.githubusercontent\\.com/[^ \\t\\r\\n<>`]+")) {
      let parts = split(regex_replace(match[0], "[),.;]+$", ""), "/");
      if (len(parts) >= 7) {
        let target = regex_replace(join(slice(parts, 6), "/"), "[?#].*$", "");
        raw_count = raw_count + 1;
        if (contains(public_paths, target) && ends_with(target, ".lms")) { raw_good = raw_good + 1; }
        else { push(raw_bad, target); }
      }
    }
  }
}
let public_doc_refs = [];
let public_reference_pattern = source_reference_pattern();
for (path in public_paths) {
  if (path == "README.md") {
    for (i in range(0, len(lines(preview_readme)))) {
      let line = lines(preview_readme)[i];
      for (match in regex_find_all(line, public_reference_pattern, "i")) { push(public_doc_refs, path + ":" + str(i + 1) + " -> " + match[0]); }
    }
  } else if (starts_with(path, "docs/") && ends_with(path, ".md")) {
    let doc_lines = read_lines(path_join(source, path));
    for (i in range(0, len(doc_lines))) {
      for (match in regex_find_all(doc_lines[i], public_reference_pattern, "i")) { push(public_doc_refs, path + ":" + str(i + 1) + " -> " + match[0]); }
    }
  }
}
let public_secret_findings = [];
let public_secret_patterns = ["gh[pousr]_[a-z0-9]{30,}", "github_pat_[a-z0-9_]{30,}", "akia[a-z0-9]{16}", "-----begin [a-z ]*private key-----", "(api[_-]?key|access[_-]?token|client[_-]?secret|password)[\"']?\\s*[:=]\\s*[\"'][a-z0-9_./+=-]{20,}[\"']"];
for (path in public_paths) {
  if (starts_with(basename(path), "THIRD_PARTY_NOTICES") || ends_with(path, ".md") || ends_with(path, ".lms") || ends_with(path, ".txt") || ends_with(path, ".json") || ends_with(path, ".svg") || ends_with(path, ".xml")) {
    let text_content = path == "README.md" ? preview_readme : read_file(path_join(source, path));
    for (pattern in public_secret_patterns) {
      if (regex_test(lower(text_content), pattern)) { push(public_secret_findings, path); break; }
    }
  }
}

let agent_ok = !audio_agent_active;
let pin_ok = len(old_consumer_pins) == 0;
let public_content_ok = raw_count == raw_good && len(raw_bad) == 0 && len(public_doc_refs) == 0 && len(public_secret_findings) == 0;
let dryrun_clean = source_clean && source_pushed && source_identity && repo_is_public && private_target_available && latest_ci_green && release_complete && local_paths_clear && agent_ok && pin_ok && public_content_ok && api_remaining > 100;

println("# lmaudio flip dry-run");
println("");
println("- Product: `lmaudio` pilot only");
println("- Source checkout: `" + source + "`");
println("- Source HEAD: `" + local_head + "`; origin/main: `" + remote_head + "`");
println("- Source remote: `" + local_origin + "`");
println("- Private target `" + private_repo + "` is available: " + str(private_target_available));
println("- Working tree clean: " + str(source_clean));
println("- Branch pushed to origin/main: " + str(source_pushed));
println("- `lmctl running` reports an active lmaudio agent: " + str(audio_agent_active));
println("- Latest main CI: `" + getstr(latest_run, "status") + "/" + getstr(latest_run, "conclusion") + "` at `" + getstr(latest_run, "headSha") + "` " + getstr(latest_run, "url"));
println("- Latest public release: `" + release_tag + "` (`" + getstr(release, "name") + "`, published " + getstr(release, "publishedAt") + ")");
println("- History consequence: transfer moves old commits, tags and releases private; only `" + release_tag + "` is re-published publicly.");
println("- Release assets to preserve: " + join(release_asset_names, ", "));
println("- GitHub core API requests remaining: " + str(api_remaining));
println("- Consumer pins to this release: " + (if_else(len(consumer_matches) == 0, "none found", join(consumer_matches, " | "))));
for (match in old_consumer_pins) { println("  - UPDATE REQUIRED before transfer: " + match); }
println("- Public README edit preview: schema/build/test/private durable-memory links removed; CI badge redirected; examples license scoped to LICENSE-examples; binary license draft added.");
println("- Public README autorun map: " + str(raw_good) + "/" + str(raw_count) + " target files staged.");
for (path in raw_bad) { println("  - MISSING PUBLIC AUTORUN TARGET: " + path); }
println("- Public docs links to private source after README edits: " + str(len(public_doc_refs)) + " finding(s).");
for (ref in public_doc_refs) { println("  - SOURCE REFERENCE: " + ref); }
println("- Public content secret scan: " + str(len(public_secret_findings)) + " finding(s); values are never printed.");
for (path in public_secret_findings) { println("  - SECRET REVIEW: " + path); }
println("- Staging destinations available: " + str(local_paths_clear));
println("- Owner approval file lists lmaudio: " + str(file_exists(approval_path) && contains(read_lines(approval_path), "lmaudio")));
println("");
println("## Apply plan (nothing below runs in dry-run mode)");
println("");
println("1. Download every `" + release_tag + "` asset, release metadata and notes to `" + release_stage + "`; verify each GitHub asset digest and SHA256SUMS.");
println("2. Build a public-only staging tree at `" + public_stage + "`: README, docs/images, examples, THIRD_PARTY_NOTICES, licenses, LICENSE-examples, LICENSE-binaries draft, and public-ci.yml.");
println("3. Transfer `" + old_public + "` to `" + private_repo + "`; immediately set it private and verify the private flag.");
println("4. Re-create `" + public_repo + "` with the same description/homepage/topics, Issues on, Wiki/Projects off; push one orphan main commit from the public staging tree.");
println("5. Re-publish `" + release_tag + "` with the exact name, notes and asset names; download/verify the Linux x64 binary, run `--version`, and check two raw example URLs.");
println("6. Point `" + source + "` origin at `" + private_repo + "`; clone the new public peer to `" + public_clone + "`.");
println("7. Install the Linux-fast/five-platform private CI workflow and `scripts/publish-release.sh`; leave automatic publication disabled unless RELEASE_TOKEN exists.");
println("8. Update the private migration record and confirm that no older consumer tag pins remain.");
println("");
if (dryrun_clean) { println("DRY-RUN CLEAN: preflight is ready for the owner approval gate; no staging or GitHub changes were made."); }
else { println("DRY-RUN BLOCKED: one or more preflight checks need attention; no staging or GitHub changes were made."); }

if (apply_requested) {
  assert(owner_flag, "REFUSED: --apply requires explicit --i-have-owner-approval");
  assert(file_exists(approval_path), "REFUSED: approval file missing: " + approval_path);
  assert(contains(read_lines(approval_path), "lmaudio"), "REFUSED: approval file must list lmaudio");
  assert(dryrun_clean, "REFUSED: lmaudio preflight is not clean");
  assert(file_exists("/home/mma/repos/dsl/lmaudio/README.md"), "REFUSED: source checkout disappeared");

  assert(mkdir(stage_root, true), "cannot create staging root: " + stage_root);
  assert(mkdir(release_stage, false), "cannot create release staging directory: " + release_stage);
  assert(mkdir(public_stage, false), "cannot create public staging directory: " + public_stage);
  let downloaded = checked(["gh", "release", "download", release_tag, "-R", old_public, "--dir", release_stage]);
  write_file(path_join(release_stage, "release.json"), json_stringify(release, 2));
  write_file(path_join(release_stage, "release-notes.md"), getstr(release, "body"));
  for (asset in release_assets) {
    let asset_name = getstr(asset, "name");
    let asset_path = path_join(release_stage, asset_name);
    assert(file_exists(asset_path), "release asset missing after download: " + asset_name);
    let actual_asset_hash = first(split(trim(checked(["sha256sum", asset_path]).stdout), " "));
    let expected_asset_hash = replace(getstr(asset, "digest"), "sha256:", "");
    assert(expected_asset_hash != "" && actual_asset_hash == expected_asset_hash, "GitHub release asset digest mismatch: " + asset_name);
  }
  let checksum_lines = read_lines(path_join(release_stage, "SHA256SUMS"));
  for (checksum_line in checksum_lines) {
    let checksum_parts = split_regex(trim(checksum_line), "\\s+");
    assert(len(checksum_parts) >= 2, "malformed SHA256SUMS line");
    let checksum_file = path_join(release_stage, checksum_parts[1]);
    let actual_hash = first(split(trim(checked(["sha256sum", checksum_file]).stdout), " "));
    assert(actual_hash == checksum_parts[0], "SHA256SUMS verification failed: " + checksum_parts[1]);
  }

  let source_files = lines(checked(["git", "-C", source, "ls-files"]).stdout);
  for (path in source_files) {
    if (public_file(path)) {
      let destination = path_join(public_stage, path);
      assert(mkdir(path_join(public_stage, dirname(path)), true), "cannot create public staging directory for " + path);
      if (path == "LICENSE") { assert(copy_file(path_join(source, path), path_join(public_stage, "LICENSE-examples")), "cannot stage LICENSE-examples"); }
      else { assert(copy_file(path_join(source, path), destination), "cannot stage " + path); }
    }
  }
  let public_readme_path = path_join(public_stage, "README.md");
  let public_readme = sanitize_readme(read_file(public_readme_path));
  assert(write_file(public_readme_path, public_readme), "cannot write sanitized public README");

  let notice_path = path_join(public_stage, "THIRD_PARTY_NOTICES");
  let notice = read_file(notice_path);
  notice = replace_all(notice, "see LICENSE.", "see LICENSE-examples.");
  notice = replace_all(notice, "Source: LICENSE", "Source: LICENSE-examples");
  assert(write_file(notice_path, notice), "cannot update public notice references");
  let binary_license_draft = "DRAFT — owner review required\n\nThis draft records the proposed future binary licensing boundary for lmaudio releases after v0.2.1. It is not a grant of rights or approved end-user license. Replace it with owner-approved terms before publishing a future proprietary binary release. The v0.2.1 release retains its original MIT LICENSE asset.\n";
  assert(write_file(path_join(public_stage, "LICENSE-binaries"), binary_license_draft), "cannot stage LICENSE-binaries draft");
  let public_workflow = path_join(public_stage, ".github", "workflows", "public-ci.yml");
  assert(mkdir(dirname(public_workflow), true), "cannot create public workflow directory");
  assert(copy_file("/home/mma/repos/dsl/lmgallery/scripts/closed-source/templates/public-ci.yml", public_workflow), "cannot stage public CI workflow");

  let staged_files = lines(checked(["git", "-C", source, "ls-files"]).stdout);
  let raw_count = 0;
  let raw_good = 0;
  let raw_bad = [];
  let staged_readme_lines = read_lines(public_readme_path);
  for (line in staged_readme_lines) {
    if (contains(lower(line), "lmctl autorun")) {
      let matches = regex_find_all(line, "https://raw\\.githubusercontent\\.com/[^ \\t\\r\\n<>`]+");
      for (match in matches) {
        let parts = split(regex_replace(match[0], "[),.;]+$", ""), "/");
        if (len(parts) >= 7) {
          let target = regex_replace(join(slice(parts, 6), "/"), "[?#].*$", "");
          raw_count = raw_count + 1;
          let found = false;
          for (path in staged_files) { if (path == target && public_file(path)) { found = true; } }
          if (found) { raw_good = raw_good + 1; } else { push(raw_bad, target); }
        }
      }
    }
  }
  assert(raw_count == raw_good && len(raw_bad) == 0, "public README autorun paths are not all staged: " + join(raw_bad, ", "));
  let reference_pattern = source_reference_pattern();
  let ref_matches = regex_find_all(public_readme, reference_pattern, "i");
  assert(len(ref_matches) == 0, "public README still references private source paths");

  let init_result = checked(["git", "-C", public_stage, "init", "-b", "main"]);
  checked(["git", "-C", public_stage, "add", "-A"]);
  checked(["git", "-C", public_stage, "-c", "user.name=mike-lmctl", "-c", "user.email=281311770+mike-lmctl@users.noreply.github.com", "commit", "-m", "Publish lmaudio demos and release documentation"]);

  checked(["gh", "api", "-X", "POST", "repos/lmctl-ai/lmaudio/transfer", "-f", "new_owner=lmctlhq"]);
  let private_ready = false;
  for (attempt in range(0, 24)) {
    let private_view = system(["gh", "repo", "view", private_repo, "--json", "nameWithOwner,isPrivate"]);
    if (private_view.code == 0 && contains(private_view.stdout, "lmctlhq/lmaudio")) { private_ready = true; break; }
    sleep_ms(5000);
  }
  assert(private_ready, "transferred source repo did not appear under lmctlhq within two minutes");
  checked(["gh", "repo", "edit", private_repo, "--visibility", "private", "--accept-visibility-change-consequences"]);
  let private_state = json_parse(checked(["gh", "api", "repos/" + private_repo]).stdout);
  assert(getbool(private_state, "private", false), "source repository is not private after the visibility change");

  let create_args = ["gh", "repo", "create", public_repo, "--public"];
  let description = getstr(repo_meta, "description");
  let homepage = getstr(repo_meta, "homepage");
  if (description != "") { push(create_args, "--description"); push(create_args, description); }
  if (homepage != "") { push(create_args, "--homepage"); push(create_args, homepage); }
  checked(create_args);
  checked(["gh", "repo", "edit", public_repo, "--default-branch", "main", "--enable-issues", "--enable-wiki=false", "--enable-projects=false"]);
  for (topic in getlist(repo_meta, "topics")) { checked(["gh", "repo", "edit", public_repo, "--add-topic", str(topic)]); }
  checked(["git", "-C", public_stage, "remote", "add", "origin", public_url]);
  checked(["git", "-C", public_stage, "push", "-u", "origin", "main"]);

  let publish_args = ["gh", "release", "create", release_tag, "-R", public_repo, "--target", "main", "--title", getstr(release, "name"), "--notes-file", path_join(release_stage, "release-notes.md")];
  for (asset in release_assets) { push(publish_args, path_join(release_stage, getstr(asset, "name"))); }
  checked(publish_args);
  let public_release = json_parse(checked(["gh", "release", "view", release_tag, "-R", public_repo, "--json", "tagName,name,body,assets,url"]).stdout);
  assert(getstr(public_release, "tagName") == release_tag && getstr(public_release, "name") == getstr(release, "name") && getstr(public_release, "body") == getstr(release, "body"), "republished release metadata differs from the staged release");
  let public_asset_names = [];
  for (asset in getlist(public_release, "assets")) { push(public_asset_names, getstr(asset, "name")); }
  assert(join(sort(public_asset_names), "\n") == join(release_asset_names, "\n"), "republished release asset names differ");

  let verify_dir = path_join(release_stage, "verify-public-download");
  assert(mkdir(verify_dir, true), "cannot create public download verification directory");
  checked(["gh", "release", "download", release_tag, "-R", public_repo, "--pattern", "lmaudio-linux-x64", "--dir", verify_dir]);
  let verified_binary = path_join(verify_dir, "lmaudio-linux-x64");
  checked(["chmod", "+x", verified_binary]);
  let verified_hash = first(split(trim(checked(["sha256sum", verified_binary]).stdout), " "));
  let original_binary_hash = "";
  for (asset in release_assets) { if (getstr(asset, "name") == "lmaudio-linux-x64") { original_binary_hash = replace(getstr(asset, "digest"), "sha256:", ""); } }
  assert(verified_hash == original_binary_hash, "downloaded public lmaudio-linux-x64 hash differs from the staged release");
  let version_result = checked([verified_binary, "--version"]);
  assert(trim(version_result.stdout) == "lmaudio " + release_version, "downloaded public binary reports an unexpected version: " + version_result.stdout);
  for (example in ["eq_before_after.lms", "karplus_strong_harp.lms"]) {
    let raw_url = "https://raw.githubusercontent.com/lmctl-ai/lmaudio/main/examples/" + example;
    let raw_path = path_join(verify_dir, example);
    checked(["curl", "-fsSL", raw_url, "-o", raw_path]);
    checked(["lmscript", "--check", raw_path]);
  }

  checked(["git", "-C", source, "remote", "set-url", "origin", source_private_url]);
  checked(["git", "-C", source, "pull", "--rebase"]);
  checked(["git", "clone", public_url, public_clone]);
  checked(["git", "-C", source, "pull", "--rebase"]);
  assert(copy_file("/home/mma/repos/dsl/lmgallery/scripts/closed-source/templates/lmaudio-private-ci.yml", path_join(source, ".github", "workflows", "ci.yml")), "cannot install private CI workflow");
  assert(copy_file("/home/mma/repos/dsl/lmgallery/scripts/closed-source/templates/publish-release.sh", path_join(source, "scripts", "publish-release.sh")), "cannot install manual release publisher");
  checked(["chmod", "+x", path_join(source, "scripts", "publish-release.sh")]);
  assert(!file_exists(path_join(source, "durable-memory", "10-private-public-peer.md")), "private migration record already exists; inspect before continuing");
  let private_migration_note = "# Private/public peer migration\n\nThe source repository moved to `lmctlhq/lmaudio`. The public peer `lmctl-ai/lmaudio` contains the docs/examples tree and retains raw example paths. The original v0.2.1 release was republished with its original tag, notes, and asset names. Future releases use the private five-platform workflow; until `RELEASE_TOKEN` is configured, a green full-matrix run is published with `scripts/publish-release.sh`.\n";
  assert(write_file(path_join(source, "durable-memory", "10-private-public-peer.md"), private_migration_note), "cannot write private migration record");
  checked(["git", "-C", source, "add", ".github/workflows/ci.yml", "scripts/publish-release.sh", "durable-memory/10-private-public-peer.md"]);
  checked(["git", "-C", source, "-c", "user.name=mike-lmctl", "-c", "user.email=281311770+mike-lmctl@users.noreply.github.com", "commit", "-m", "Run Linux CI on pushes and gate full release builds"]);
  checked(["git", "-C", source, "pull", "--rebase"]);
  checked(["git", "-C", source, "push", "origin", "main"]);
  println("PILOT COMPLETE: lmaudio source is private, the public peer and v0.2.1 release are restored, two raw examples checked, and the local public clone is ready. Stop before any other product.");
}
