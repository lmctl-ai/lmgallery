# SPDX-License-Identifier: MIT
# A monthly demand series: 60 months of history with a linear trend, an annual cycle and
# Gaussian noise (sigma 4), and a 12-month forecast. lmnum does the statistics: a least-squares
# fit of trend plus annual harmonics (design matrix, lstsq), the residual standard deviation,
# and the 95 % prediction interval for each future month,
#   mean +- 1.96 s sqrt(1 + x0' (X'X)^-1 x0).
# lmplot draws the history, the fit, the forecast with its band widening into the future, and the
# true curve. The program checks that at least 10 of the 12 true future values fall inside the band.
mkdir("images");
mkdir("build");

sim = _lmcode_ cli="lmnum" install="github:lmctl-ai/lmnum@latest";
let nh = 60;
let nf = 12;
let p = 4;
let z = num.normal(nh, 1, 11);
let x_design = num.matrix(nh, p);
let y_obs = num.matrix(nh, 1);
for (i in range(0, nh)) {
  let t = float(i);
  let w = 6.283185307179586 * t / 12.0;
  x_design = x_design.set(i, 0, 1.0).set(i, 1, t / 60.0).set(i, 2, sin(w)).set(i, 3, cos(w));
  y_obs = y_obs.set(i, 0, 120.0 + 2.2 * t + 8.0 * sin(w) + 4.0 * z.get(i, 0));
}
let beta = x_design.lstsq(y_obs);
let fitted = x_design.mul(beta);
let resid = y_obs.sub(fitted);
let s = sqrt(resid.transpose().mul(resid).get(0, 0) / float(nh - p));
let xtx_inv = x_design.transpose().mul(x_design).inverse();

let history = num.matrix(nh, 3);
for (i in range(0, nh)) {
  history = history.set(i, 0, float(i)).set(i, 1, y_obs.get(i, 0)).set(i, 2, fitted.get(i, 0));
}
history.save_csv("build/forecast-history.csv");

let forecast = num.matrix(nf, 5);
let covered = 0.0;
for (f in range(0, nf)) {
  let i = nh + f;
  let t = float(i);
  let w = 6.283185307179586 * t / 12.0;
  let x0 = num.matrix(p, 1).set(0, 0, 1.0).set(1, 0, t / 60.0).set(2, 0, sin(w)).set(3, 0, cos(w));
  let mean = x0.transpose().mul(beta).get(0, 0);
  let q = x0.transpose().mul(xtx_inv).mul(x0).get(0, 0);
  let half = 1.96 * s * sqrt(1.0 + q);
  let truth = 120.0 + 2.2 * t + 8.0 * sin(w);
  if (truth >= mean - half && truth <= mean + half) { covered = covered + 1.0; }
  forecast = forecast.set(f, 0, t).set(f, 1, mean).set(f, 2, mean - half).set(f, 3, mean + half).set(f, 4, truth);
}
num.assert_close(covered, 11.0, 1.5);
forecast.save_csv("build/forecast-band.csv");
end _lmcode_
savedsl(sim, "build/forecast-sim.dslb");
r = system ${dsl_cli(sim)} --dsl build/forecast-sim.dslb;
assert(r.code == 0, r.stdout + r.stderr);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/showcase-21-forecast-band.png", 900, 500);
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#dbe4ee'; set key font ',9' samplen 2 bottom right box opaque");
plot.cmd("set title 'Monthly demand: 12-month forecast with a 95 % prediction band (lmnum least squares)' font ',13'");
plot.cmd("set xlabel 'month'; set ylabel 'demand'");
plot.cmd("set xrange [0:72]; set yrange [100:300]");
plot.cmd("plot 'build/forecast-band.csv' using 1:3:4 with filledcurves fc rgb '#bfdbfe' fs solid 0.9 title '95 % prediction band', 'build/forecast-history.csv' using 1:3 with lines lw 2.2 lc rgb '#2563eb' title 'fitted trend and season', 'build/forecast-history.csv' using 1:2 with points pt 7 ps 0.9 lc rgb '#1e3a8a' title 'observed', 'build/forecast-band.csv' using 1:2 with lines dt 2 lw 2.2 lc rgb '#dc2626' title 'forecast', 'build/forecast-band.csv' using 1:5 with lines dt 3 lw 1.6 lc rgb '#111827' title 'true curve (generator)'");
plot.close();
end _lmcode_
savedsl(draw, "build/forecast-draw.dslb");
r = system ${dsl_cli(draw)} --dsl build/forecast-draw.dslb;
assert(r.code == 0, r.stdout + r.stderr);
println("wrote images/showcase-21-forecast-band.png");
