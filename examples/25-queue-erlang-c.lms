# SPDX-License-Identifier: MIT
# A call centre with 8 agents, each serving 10 calls per hour, over one day. The arrival rate
# follows a daytime peak (up to 70 calls per hour). For each hour, lmnum evaluates the M/M/c
# Erlang-C formula at the offered load a = lambda / mu:
#   C(c, a) = [a^c/c! * c/(c-a)] / [sum_{k<c} a^k/k! + a^c/c! * c/(c-a)],   Lq = C * a/(c-a),
# and the mean number of busy agents a. The formula is checked against its textbook value
# C(2, 1) = 1/3 first. lmplot draws the busy agents as bars on the right axis and the queue
# length as a line on the left axis. The quasi-static model holds while the load stays below
# the 8 agents (the peak is at 0.9 of capacity).
mkdir("images");
mkdir("build");

sim = _lmcode_ cli="lmnum" install="github:lmctl-ai/lmnum@latest";
let c_agents = 8;
let mu = 10.0;

# Erlang-C in a function of the agent count and the offered load.
fn erlang_c(c: int, a: float) -> float {
  let term = 1.0;
  let sum = 0.0;
  for (k in range(0, c)) {
    if (k > 0) { term = term * a / float(k); }
    sum = sum + term;
  }
  # term now holds a^(c-1)/(c-1)!; the c-th term is a^c/c!.
  let top = term * a / float(c) * float(c) / (float(c) - a);
  return top / (sum + top);
}
num.assert_close(erlang_c(2, 1.0), 0.333333333333, 0.000001);

let hours = num.matrix(24, 4);
for (h in range(0, 24)) {
  let dh = float(h) - 13.0;
  let lam = 30.0 + 40.0 * pow(2.718281828459045, -dh * dh / 12.0);
  let a = lam / mu;
  let pw = erlang_c(c_agents, a);
  let lq = pw * a / (float(c_agents) - a);
  hours = hours.set(h, 0, float(h)).set(h, 1, lam).set(h, 2, a).set(h, 3, lq);
}
hours.save_csv("build/queue.csv");
end _lmcode_
savedsl(sim, "build/queue-sim.dslb");
r = system ${dsl_cli(sim)} --lmcode build/queue-sim.dslb;
assert(r.code == 0, r.stdout + r.stderr);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/showcase-25-queue-erlang-c.png", 900, 460);
plot.cmd("set border 3; set tics nomirror; set grid ytics lc rgb '#dbe4ee'; set key top left font ',9' samplen 2 box opaque");
plot.cmd("set title 'Call centre, 8 agents: queue length and busy agents over one day (Erlang-C, lmnum)' font ',12'");
plot.cmd("set xlabel 'hour of day'; set xrange [-0.5:23.5]; set xtics 0,3,23 nomirror");
plot.cmd("set ylabel 'mean queue length (calls waiting)'; set yrange [0:6]");
plot.cmd("set y2label 'busy agents (of 8)'; set y2range [0:8]; set y2tics 0,2,8");
plot.cmd("set style fill solid 0.35 border -1; set boxwidth 0.6");
plot.cmd("plot 'build/queue.csv' using 1:3 axes x1y2 with boxes lc rgb '#94a3b8' title 'busy agents (offered load)', 'build/queue.csv' using 1:4 with linespoints lw 2.6 pt 7 ps 0.9 lc rgb '#dc2626' title 'queue length Lq'");
plot.close();
end _lmcode_
savedsl(draw, "build/queue-draw.dslb");
r = system ${dsl_cli(draw)} --lmcode build/queue-draw.dslb;
assert(r.code == 0, r.stdout + r.stderr);
println("wrote images/showcase-25-queue-erlang-c.png");
