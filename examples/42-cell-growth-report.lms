# SPDX-License-Identifier: MIT
# Cell-population growth with stochastic division. lmcell seeds 2000 growing cells that divide on a
# 0.3 per minute cycle (a stochastic cell-based model with diffusion of nutrients on a 2D grid) and
# runs for two minutes, recording the live-cell count every 0.16 minutes at twelve points. The
# program checks the final count against the expected exponential 2000 exp(0.3 t) within 10 %. lmvideo
# draws the simulated counts against that curve as a PNG (the gallery output); lmoffice writes the
# lab report with the method, a results table and the figure.
mkdir("images");
mkdir("build");

sim = _lmcode_ cli="lmcell" install="github:lmctl-ai/lmcell@v0.1.3";
let s = cell.sim(12345);
s.cell_type("growing").cycle(0.3).radius(1.0);
let r = s.seed("growing", 2000, 0.0, 0.0).run(2.0, 0.01);
let h = r.counts();
cell.assert_close(float(r.live()), cell.eval("2000*exp(0.6)"), 200.0);
cell.print("n0=" + str(h.get(0, 1)));
cell.print("n1=" + str(h.get(16, 1)));
cell.print("n2=" + str(h.get(32, 1)));
cell.print("n3=" + str(h.get(48, 1)));
cell.print("n4=" + str(h.get(64, 1)));
cell.print("n5=" + str(h.get(80, 1)));
cell.print("n6=" + str(h.get(96, 1)));
cell.print("n7=" + str(h.get(112, 1)));
cell.print("n8=" + str(h.get(128, 1)));
cell.print("n9=" + str(h.get(144, 1)));
cell.print("n10=" + str(h.get(160, 1)));
cell.print("n11=" + str(h.get(176, 1)));
h.save_csv("build/cell-counts.csv");
end _lmcode_
savedsl(sim, "build/cell-sim.dslb");
r = system(concat(dsl_cli(sim), ["--lmcode", "build/cell-sim.dslb"]), 900000);
assert(r.code == 0, r.stdout + r.stderr);

let n0 = 0.0; let n1 = 0.0; let n2 = 0.0; let n3 = 0.0; let n4 = 0.0; let n5 = 0.0; let n6 = 0.0; let n7 = 0.0; let n8 = 0.0; let n9 = 0.0; let n10 = 0.0; let n11 = 0.0;
for (line in split(r.stdout, "\n")) {
  let parts = split(line, "=");
  if (starts_with(line, "n0=")) { n0 = num(parts[1]); }
  if (starts_with(line, "n1=")) { n1 = num(parts[1]); }
  if (starts_with(line, "n2=")) { n2 = num(parts[1]); }
  if (starts_with(line, "n3=")) { n3 = num(parts[1]); }
  if (starts_with(line, "n4=")) { n4 = num(parts[1]); }
  if (starts_with(line, "n5=")) { n5 = num(parts[1]); }
  if (starts_with(line, "n6=")) { n6 = num(parts[1]); }
  if (starts_with(line, "n7=")) { n7 = num(parts[1]); }
  if (starts_with(line, "n8=")) { n8 = num(parts[1]); }
  if (starts_with(line, "n9=")) { n9 = num(parts[1]); }
  if (starts_with(line, "n10=")) { n10 = num(parts[1]); }
  if (starts_with(line, "n11=")) { n11 = num(parts[1]); }
}
let expected_end = 2000.0 * pow(2.718281828459045, 0.6);
assert(abs(n11 - expected_end) / expected_end < 0.1);

# Figure (lmvideo): simulated live cells and the expected exponential.
figure = _lmcode_ cli="lmvideo" install="github:lmctl-ai/lmvideo@v0.1.36";
video.size(900, 480); video.frames(1); video.output("images/showcase-42-cell-growth.png"); video.begin();
video.frame();
canvas.clear("#ffffff");
let fig = canvas.panel(12.0, 12.0, 876.0, 456.0).manager("box_v").padding(10.0, 10.0, 10.0, 10.0).gap(6.0).background("#ffffff");
let plot = fig.add_plot().weight(1.0).fill("both").plot().title("Live cells: stochastic division against exponential growth (lmcell)").xlabel("time (minutes)").ylabel("live cells").x_range(0.0, 2.0).y_range(1500.0, 4200.0).legend("top_left").background("#ffffff");
let expected = plot.series("expected 2000 exp(0.3 t)", "line", "#94a3b8").width(2.0);
expected.add(0.0, 2000.0); expected.add(0.16, 2000.0 * 1.04957); expected.add(0.32, 2000.0 * 1.10107);
expected.add(0.48, 2000.0 * 1.15514); expected.add(0.64, 2000.0 * 1.21189); expected.add(0.80, 2000.0 * 1.27136);
expected.add(0.96, 2000.0 * 1.33372); expected.add(1.12, 2000.0 * 1.39906); expected.add(1.28, 2000.0 * 1.46752);
expected.add(1.44, 2000.0 * 1.53926); expected.add(1.60, 2000.0 * 1.61448); expected.add(1.76, 2000.0 * 1.69337);
let live = plot.series("lmcell live cells", "scatter", "#1F4E78").marker("circle");
live.add(0.00, ${n0 + 0.000000001}); live.add(0.16, ${n1 + 0.000000001}); live.add(0.32, ${n2 + 0.000000001}); live.add(0.48, ${n3 + 0.000000001}); live.add(0.64, ${n4 + 0.000000001}); live.add(0.80, ${n5 + 0.000000001}); live.add(0.96, ${n6 + 0.000000001}); live.add(1.12, ${n7 + 0.000000001}); live.add(1.28, ${n8 + 0.000000001}); live.add(1.44, ${n9 + 0.000000001}); live.add(1.60, ${n10 + 0.000000001}); live.add(1.76, ${n11 + 0.000000001});
fig.draw();
video.end();
end _lmcode_
savedsl(figure, "build/cell-figure.dslb");
r = system(concat(dsl_cli(figure), ["--lmcode", "build/cell-figure.dslb"]), 300000);
assert(r.code == 0, r.stdout + r.stderr);

# Lab report (lmoffice).
report = _lmcode_ cli="lmoffice docx" install="github:lmctl-ai/lmoffice@v0.1.29";
let doc = docx.create("build/cell-growth-report.docx");
doc.title("Cell growth lab report").author("Multicellular systems group");
doc.heading("Cell growth lab report", 1).bold(true);
doc.heading("Method", 2);
doc.paragraph("2000 growing cells, each dividing on a 0.3 per minute cycle, were simulated with lmcell for two minutes on a 2D nutrient grid (stochastic division, fixed seed 12345). The live-cell count was recorded every 0.16 minutes.");
doc.heading("Results", 2);
let t = doc.table(2, 3);
t.cell(1, 1, "Quantity").cell(1, 2, "Simulated").cell(1, 3, "Expected 2000 exp(0.6)");
t.cell(2, 1, "Live cells at t = 2 min").cell(2, 2, ${str(round(n11 * 10.0) / 10.0)}).cell(2, 3, ${str(round(expected_end * 10.0) / 10.0)});
doc.image("images/showcase-42-cell-growth.png", 600, 320);
doc.heading("Conclusion", 2);
doc.paragraph("The simulated count follows the exponential growth expected from the division rate, within 10 %.");
doc.save();
end _lmcode_
savedsl(report, "build/cell-growth-report.dslb");
r = system(concat(dsl_cli(report), ["--lmcode", "build/cell-growth-report.dslb"]), 300000);
assert(r.code == 0, r.stdout + r.stderr);
println("wrote build/cell-growth-report.docx and images/showcase-42-cell-growth.png");
