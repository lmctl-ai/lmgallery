# SPDX-License-Identifier: MIT
# A discounted project decision: lmfinance supplies the zero curve and present
# values; lmdraw turns those computed cashflows into an annotated diagram.
mkdir("images");
mkdir("data");
mkdir("build/rendered");
calc = _dsl_ cli="lmfinance" install="github:lmctl-ai/lmfinance@latest";
let curve = market.flat_curve(0.08);
let f0 = -100.0; let f1 = 18.0; let f2 = 25.0; let f3 = 30.0;
let f4 = 30.0; let f5 = 25.0; let f6 = 30.0;
let rows = "year cashflow discount_factor present_value\n";
let npv = 0.0;
for (t in range(0, 7)) {
  let df = curve.discount(float(t));
  let cash = f6;
  if (t == 0) { cash = f0; }
  if (t == 1) { cash = f1; }
  if (t == 2) { cash = f2; }
  if (t == 3) { cash = f3; }
  if (t == 4) { cash = f4; }
  if (t == 5) { cash = f5; }
  let pv = cash * df;
  npv = npv + pv;
  rows = rows + str(t) + " " + str(cash) + " " + str(df) + " " + str(pv) + "\n";
}
lmf.assert_close(npv, 18.6244988084, 0.0000001);
lmf.save_text("data/cashflows.csv", rows);
lmf.print("NPV at 8% = " + str(npv) + " k$");
end _dsl_
savedsl(calc, "data/cashflows-calc.dslb");
r = system ${dsl_cli(calc)} --dsl data/cashflows-calc.dslb;
assert(r.code == 0, r.stdout + r.stderr);

# Read the generated CSV with lmnum, then generate the lmdraw source from its
# numeric columns. This keeps every arrow, PV label, and the NPV metric tied to
# the actual lmfinance output rather than duplicating computed values.
read = _dsl_ cli="lmnum" install="github:lmctl-ai/lmnum@latest";
let table = num.load_csv("data/cashflows.csv");
let npv_read = 0.0;
let source = "mkdir(\"images\");\np = _dsl_ cli=\"lmdraw\" install=\"github:lmctl-ai/lmdraw@latest\";\nscene.canvas(900, 540, \"#f8fafc\");\nscene.text(40.0, 42.0, 23.0, \"Capital project cashflows at an 8% discount rate\", \"#0f172a\").set_attr(\"font-weight\", \"700\");\nscene.text(40.0, 68.0, 13.0, \"Continuous 8% discounting: finance computes, num reads, draw annotates\", \"#475569\");\nscene.line(90.0, 250.0, 760.0, 250.0, \"#64748b\", 2.0).set_attr(\"marker-end\", \"arrow\");\n";
for (t in range(0, 7)) {
  let x = 110.0 + 105.0 * float(t);
  let cash = table.get(t, 1);
  let pv = table.get(t, 3);
  let pv_short = floor(pv * 10.0 + 0.5) / 10.0;
  npv_read = npv_read + pv;
  let y = 250.0 - cash * 1.2 + 0.001;
  let year_y = 275.0;
  let color = "#059669";
  if (cash < 0.0) { color = "#dc2626"; year_y = 235.0; }
  let label_y = y - 10.0 + 0.001;
  if (cash < 0.0) { label_y = y + 20.0 + 0.001; }
  source = source + "scene.line(" + str(x) + ".0, 246.0, " + str(x) + ".0, 254.0, \"#64748b\", 1.0);\n";
  source = source + "scene.text(" + str(x) + ".0, " + str(year_y) + ".0, 12.0, \"year " + str(t) + "\", \"#475569\").set_attr(\"text-anchor\", \"middle\");\n";
  source = source + "scene.arrow(" + str(x) + ".0, 250.0, " + str(x) + ".0, " + str(y) + ", \"" + color + "\", 4.0);\n";
  source = source + "scene.text(" + str(x) + ".0, " + str(label_y) + ", 12.0, \"" + str(cash) + "k\", \"" + color + "\").set_attr(\"text-anchor\", \"middle\");\n";
  source = source + "scene.text(" + str(x) + ".0, 410.0, 10.5, \"PV " + str(pv_short) + "k\", \"#475569\").set_attr(\"text-anchor\", \"middle\");\n";
}
source = source + "scene.rect(610.0, 420.0, 245.0, 92.0, \"#e0f2fe\").set_attr(\"rx\", \"8\"); scene.text(632.0, 450.0, 12.0, \"Decision metric\", \"#075985\").set_attr(\"font-weight\", \"700\"); scene.text(632.0, 480.0, 21.0, \"NPV ";
source = source + str(floor(npv_read * 10.0 + 0.5) / 10.0) + "k\", \"#047857\").set_attr(\"font-weight\", \"700\"); scene.text(40.0, 445.0, 15.0, \"How to read the diagram\", \"#0f172a\").set_attr(\"font-weight\", \"700\"); scene.text(40.0, 470.0, 13.0, \"Red is the initial investment; green arrows are future receipts.\", \"#334155\"); scene.text(40.0, 495.0, 13.0, \"The PV labels are read directly from lmfinance's generated CSV.\", \"#334155\"); scene.text(40.0, 520.0, 13.0, \"Positive NPV means the receipts beat the 8% cost of capital.\", \"#334155\"); scene.render_png(\"build/rendered/showcase-02-finance-cashflows.png\", 900, 540, 1);\nend _dsl_\nsavedsl(p, \"data/cashflows-draw.dslb\");\nargv = dsl_cli(p); push(argv, \"--dsl\"); push(argv, \"data/cashflows-draw.dslb\"); r = system(argv);\nassert(r.code == 0, r.stdout + r.stderr);\n";
num.assert_close(npv_read, 18.6244988084, 0.0000001);
num.print(source);
end _dsl_
savedsl(read, "data/cashflows-read.dslb");
r = system ${dsl_cli(read)} --dsl data/cashflows-read.dslb;
assert(r.code == 0, r.stdout + r.stderr);
write_file("data/cashflows-draw.lms", split(r.stdout, "{\"ok\"")[0]);
r = system lmscript data/cashflows-draw.lms;
assert(r.code == 0, r.stdout + r.stderr);
copy_file("build/rendered/showcase-02-finance-cashflows.png", "images/showcase-02-finance-cashflows.png");
println("wrote images/showcase-02-finance-cashflows.png");
