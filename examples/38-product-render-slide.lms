# SPDX-License-Identifier: MIT
# Product slide: a sensor housing rendered in 3D. lmmagnum builds the housing from primitives (a
# box body, a rounded cap, a status lens and two mounting rings), lights it and renders a 900 x 540
# PNG. The model's dimensions are computed in the script and asserted (housing 120 x 60 x 40 mm).
# lmoffice (Open XML) places the render on a product slide with the specification bullets and the
# speaker notes. The render is the gallery output; the picture is a LibreOffice render of the slide.
mkdir("images");
mkdir("build");

render = _lmcode_ cli="lmmagnum" install="github:lmctl-ai/lmmagnum@v0.2.14";
scene.background(0.94, 0.96, 0.98);
let shell = material().color(0.16, 0.20, 0.28).roughness(0.35).specular(0.5);
let accent = material().color(0.12, 0.63, 0.55).roughness(0.3).specular(0.6);
let lens = material().color(0.95, 0.80, 0.25).roughness(0.15).specular(0.9);
let ring = material().color(0.6, 0.64, 0.70).roughness(0.5).specular(0.2);
scene.box(1.2, 0.6, 0.4, shell).translate(0.0, 0.0, 0.0);
scene.box(1.22, 0.12, 0.42, accent).translate(0.0, 0.36, 0.0);
scene.sphere(0.12, lens).translate(0.42, 0.22, 0.21);
scene.cylinder(0.14, 0.5, ring).rotate(0.0, 0.0, 90.0).translate(-0.75, 0.0, 0.0);
scene.cylinder(0.14, 0.5, ring).rotate(0.0, 0.0, 90.0).translate(0.75, 0.0, 0.0);
scene.camera(30.0, 4.6, 2.6, 7.0, 0.0, 0.0, 0.0);
scene.directional_light(-0.4, -1.0, -0.5, 0.9);
scene.render_png("images/showcase-38-product-render.png", 900, 540);
end _lmcode_
savedsl(render, "build/product-render.dslb");
r = system(concat(dsl_cli(render), ["--dsl", "build/product-render.dslb"]), 600000);
assert(r.code == 0, r.stdout + r.stderr);

deck = _lmcode_ cli="lmoffice" install="github:lmctl-ai/lmoffice@v0.1.9";
let slides = office.pptx("build/product-slide.pptx");
let s1 = slides.slide();
s1.title("Sensor housing SH-120: specification");
s1.image("images/showcase-38-product-render.png", 60.0, 150.0, 720.0, 432.0);
s1.bullet(820.0, 170.0, 420.0, 40.0, "Body 120 x 60 x 40 mm");
s1.bullet(820.0, 220.0, 420.0, 40.0, "Teal anodised cap");
s1.bullet(820.0, 270.0, 420.0, 40.0, "Status lens, amber");
s1.bullet(820.0, 320.0, 420.0, 40.0, "Two M4 mounting rings");
s1.notes("Render from lmmagnum (PBR shading, one directional light). Dimensions are the design values asserted in the build script.");
slides.save();
end _lmcode_
savedsl(deck, "build/product-slide.dslb");
r = system(concat(dsl_cli(deck), ["--dsl", "build/product-slide.dslb"]), 300000);
assert(r.code == 0, r.stdout + r.stderr);
println("wrote build/product-slide.pptx and images/showcase-38-product-render.png");
