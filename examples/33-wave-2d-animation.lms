# SPDX-License-Identifier: MIT
# A standing-wave field on a square membrane, animated over one period of its fundamental mode.
# lmnum discretizes the Laplacian of the unit square (7 x 7 interior nodes, h = 1/8), computes its
# eigenvalues with eig_sym, and checks the smallest and the twice-degenerate second eigenvalue
# against the closed form lambda_mn = (2 - 2 cos(m pi h))/h^2 + (2 - 2 cos(n pi h))/h^2. The mode
# frequencies w = sqrt(lambda) drive the animation. lmvideo draws the displacement field
#   u(x, y, t) = sin(pi x) sin(pi y) cos(w11 t) + sin(2 pi x) sin(pi y) cos(w21 t)
# as a 34 x 34 colour field on a canvas, 48 frames at 12 fps, and encodes it to MP4 with ffmpeg.
# The gallery picture is the first frame of the film (t = 0, both modes in phase), saved as a PNG.
mkdir("images");
mkdir("build");

modes = _dsl_ cli="lmnum" install="github:lmctl-ai/lmnum@latest";
let n = 7;
let h = 0.125;
let pi = 3.141592653589793;
let lap = num.matrix(49, 49);
for (j in range(0, n)) {
  for (i in range(0, n)) {
    let k = j * n + i;
    lap = lap.set(k, k, 4.0 / (h * h));
    if (i > 0) { lap = lap.set(k, k - 1, -1.0 / (h * h)); }
    if (i < n - 1) { lap = lap.set(k, k + 1, -1.0 / (h * h)); }
    if (j > 0) { lap = lap.set(k, k - n, -1.0 / (h * h)); }
    if (j < n - 1) { lap = lap.set(k, k + n, -1.0 / (h * h)); }
  }
}
let eig = lap.eig_sym();
let lam11 = 2.0 * (2.0 - 2.0 * cos(pi * h)) / (h * h);
let lam21 = (2.0 - 2.0 * cos(2.0 * pi * h)) / (h * h) + (2.0 - 2.0 * cos(pi * h)) / (h * h);
let smallest = 1000000.0;
let at_lam21 = 0;
for (k in range(0, 49)) {
  let v = eig.get(k, 0);
  if (v < smallest) { smallest = v; }
  if (abs(v - lam21) < 0.000000001) { at_lam21 = at_lam21 + 1; }
}
num.assert_close(smallest, lam11, 0.000000001);
num.assert_close(float(at_lam21), 2.0, 0.0);
num.print("w11=" + str(sqrt(lam11)));
num.print("w21=" + str(sqrt(lam21)));
end _dsl_
savedsl(modes, "build/wave-modes.dslb");
r = system(concat(dsl_cli(modes), ["--dsl", "build/wave-modes.dslb"]), 300000);
assert(r.code == 0, r.stdout + r.stderr);

let w11 = 0.0;
let w21 = 0.0;
for (line in split(r.stdout, "\n")) {
  let parts = split(line, "=");
  if (starts_with(line, "w11=")) { w11 = num(parts[1]); }
  if (starts_with(line, "w21=")) { w21 = num(parts[1]); }
}
let period = 6.283185307179586 / w11;

film = _dsl_ cli="lmvideo" install="github:lmctl-ai/lmvideo@v0.1.25";
fn field_color(u: float) -> string {
  let c = "#ffffff";
  if (u < 0.0) { c = mix("#1e3a8a", "#ffffff", u + 1.0); } else { c = mix("#ffffff", "#9a3412", u); }
  return c;
}
video.size(900, 540); video.frames(48); video.fps(12); video.output("build/wave-2d.mp4"); video.begin();
for (frame in range(0, video.count())) {
  video.frame();
  let t = float(video.index()) * ${period} / float(video.count());
  canvas.clear("#ffffff");
  canvas.text("Standing waves on a membrane: lmnum modes, lmvideo frames", 30.0, 44.0, font(22.0).bold(true), paint().color("#0f172a"));
  for (j in range(0, 34)) {
    for (i in range(0, 34)) {
      let x = (float(i) + 0.5) / 34.0;
      let y = (float(j) + 0.5) / 34.0;
      let u = sin(3.141592653589793 * x) * sin(3.141592653589793 * y) * cos(${w11} * t) + 1.0 * sin(6.283185307179586 * x) * sin(3.141592653589793 * y) * cos(${w21} * t);
      canvas.rect(40.0 + float(i) * 13.0, 80.0 + float(j) * 13.0, 13.0, 13.0, paint().color(field_color(0.5 * u)));
    }
  }
  canvas.text("t = " + str(floor(t * 1000.0 + 0.5) / 1000.0) + " s", 540.0, 130.0, font(20.0), paint().color("#334155"));
  if (video.index() == 0) { video.save_frame("images/showcase-33-wave-2d.png"); }
}
video.end();
end _dsl_
savedsl(film, "build/wave-2d-film.dslb");
r = system(concat(dsl_cli(film), ["--dsl", "build/wave-2d-film.dslb"]), 900000);
assert(r.code == 0, r.stdout + r.stderr);
println("wrote build/wave-2d.mp4 and images/showcase-33-wave-2d.png");
