# SPDX-License-Identifier: MIT
# Designing a dosing regimen: lmbio integrates a one-compartment oral model
# (absorption ka = 1 /h, half-life 6 h, volume 40 L) for 800 mg a day given as
# 400 mg every 12 h or 800 mg once a day, restarting from the previous state at
# every dose. Both regimens have the same average level (dose / (CL tau) =
# 7.2 mg/L, asserted) but only the twice-daily one stays inside the 3-12 mg/L
# therapeutic window. lmvideo draws the compartment model; lmplot overlays the
# window, the shared average and the two concentration profiles.
mkdir("build/pk");
mkdir("build/rendered");
mkdir("images");
ke = 0.11552453009332421;
volume = 40.0;
clearance = ke * volume;
compute = _lmcode_ cli="lmbio" install="github:lmctl-ai/lmbio@latest";
let m = bio.model("oral_one_compartment").compartment("body", 1.0).species("G", "body", 0.0).species("C", "body", 0.0);
m.param("ka", 1.0).param("ke", ${ke}).param("AUC", 0.0);
m.reaction("absorb", "G -> C", "ka*G").reaction("eliminate", "C ->", "ke*C");
m.rate_rule("AUC", "C");
m.tol(0.0000000001, 0.000000000001);
let clearance = ${clearance};
for (regimen in range(0, 2)) {
  let tau = 12.0; let dose = 400.0; let tag = "q12";
  if (regimen == 1) { tau = 24.0; dose = 800.0; tag = "q24"; }
  let doses = int(96.0 / tau);
  let g = 0.0; let c = 0.0; let auc = 0.0; let auc_last = 0.0;
  let inside = 0; let samples = 0;
  for (k in range(0, doses)) {
    m.set("G", g + dose / 40.0).set("C", c).set("AUC", auc);
    let t0 = tau * float(k);
    let r = m.simulate(t0, t0 + tau, int(tau * 10.0) + 1);
    r.save_csv("build/pk/" + tag + "_" + str(k) + ".csv");
    auc_last = r.final("AUC") - auc;
    g = r.final("G"); c = r.final("C"); auc = r.final("AUC");
    if (t0 >= 72.0) {
      for (i in range(1, r.rows())) {
        let level = r.value("C", i);
        samples = samples + 1;
        if (level >= 3.0 && level <= 12.0) { inside = inside + 1; }
      }
    }
  }
  bio.assert_close(auc_last, dose / clearance, 0.005 * dose / clearance);
  bio.assert_close(auc_last / tau, 800.0 / 24.0 / clearance, 0.05);
  if (regimen == 0) { bio.assert_true(inside == samples); } else { bio.assert_true(inside < samples); }
  bio.print(tag + "," + str(inside) + "," + str(samples) + "," + str(auc_last / tau));
}
end _lmcode_
savedsl(compute, "build/pk/compute.dslb");
r = system ${dsl_cli(compute)} --lmcode build/pk/compute.dslb;
assert(r.code == 0, r.stdout + r.stderr);
coverage = {};
for (line in lines(r.stdout)) {
  f = split(line, ",");
  if (f[0] == "q12" || f[0] == "q24") { coverage[f[0]] = 100.0 * num(f[1]) / num(f[2]); }
}
css = 800.0 / 24.0 / clearance;
cov12 = coverage["q12"]; cov24 = coverage["q24"];
half_life = 0.6931471805599453 / ke;
println(sprintf("Css,avg = %.2f mg/L; time in window at steady state: q12 %.0f%%, q24 %.0f%%", css, coverage["q12"], coverage["q24"]));

d = _lmcode_ cli="lmvideo" install="github:lmctl-ai/lmvideo@v0.1.36";
let __lmvideo_font_regular = font_load("https://raw.githubusercontent.com/lmctl-ai/lmdraw/7e8623f88b7baef858a405064823c2244fac7420/assets/fonts/NotoSans-Regular.ttf", "478c558ea716033cd60c03438f628dfa75694dcf6b5f6d505a2f05fd2b4f3823");
let __lmvideo_font_bold = font_load("https://raw.githubusercontent.com/lmctl-ai/lmdraw/7e8623f88b7baef858a405064823c2244fac7420/assets/fonts/NotoSans-Bold.ttf", "1df075a380fc7cb898acf64c1f7b3b4dd780de3caa860178bf929de35817a913");
let __lmvideo_font_math = font_load("https://raw.githubusercontent.com/lmctl-ai/lmdraw/ca2f5a635519fcc2200dbdc73a04e7388773dfb7/assets/fonts/NotoSansMath-Regular.ttf", "d51afd5739c7ba6c44fcab35a88160e25dfb69a2d4ad0bd99533f8d894af1f96");
canvas.typeface(__lmvideo_font_regular);
canvas.target(surface(400, 560)); canvas.clear("#f8fafc");
canvas.text(20.0, 36.0, 17.0, "One-compartment oral model", "#0f172a").set_attr("font-weight", "700");
canvas.text(20.0, 58.0, 12.0, "first-order absorption and elimination", "#475569");
canvas.rect(120.0, 90.0, 160.0, 54.0, "#fde68a").set_attr("rx", "10");
canvas.text(200.0, 112.0, 13.0, "oral dose", "#78350f").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
canvas.text(200.0, 131.0, 11.0, "400 mg q12h  or  800 mg q24h", "#78350f").set_attr("text-anchor", "middle");
canvas.arrow(200.0, 146.0, 200.0, 194.0, "#334155", 2.5).set_attr("marker-end", "arrow");
canvas.rect(110.0, 200.0, 180.0, 60.0, "#bfdbfe").set_attr("rx", "10");
canvas.text(200.0, 225.0, 13.0, "gut depot G", "#1e3a8a").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
canvas.text(200.0, 246.0, 11.0, "absorbed at ka = 1.0 /h", "#1e3a8a").set_attr("text-anchor", "middle");
canvas.arrow(200.0, 262.0, 200.0, 314.0, "#334155", 2.5).set_attr("marker-end", "arrow");
canvas.text(214.0, 293.0, 11.0, "ka G", "#334155");
canvas.rect(110.0, 320.0, 180.0, 70.0, "#bbf7d0").set_attr("rx", "10");
canvas.text(200.0, 345.0, 13.0, "plasma C", "#14532d").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
canvas.text(200.0, 364.0, 11.0, ${sprintf("V = %.0f L, measured in mg/L", volume)}, "#14532d").set_attr("text-anchor", "middle");
canvas.text(200.0, 380.0, 11.0, ${sprintf("half-life %.1f h", half_life)}, "#14532d").set_attr("text-anchor", "middle");
canvas.arrow(200.0, 392.0, 200.0, 444.0, "#334155", 2.5).set_attr("marker-end", "arrow");
canvas.text(214.0, 423.0, 11.0, "ke C", "#334155");
canvas.rect(110.0, 450.0, 180.0, 54.0, "#e2e8f0").set_attr("rx", "10");
canvas.text(200.0, 473.0, 13.0, "elimination", "#334155").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
canvas.text(200.0, 492.0, 11.0, ${sprintf("CL = ke V = %.2f L/h", clearance)}, "#334155").set_attr("text-anchor", "middle");
canvas.text(20.0, 540.0, 11.0, ${sprintf("Css,avg = dose / (CL tau) = %.1f mg/L for both regimens", css)}, "#0f172a");
canvas.redraw(); canvas.png("build/rendered/pk_model.png", 400, 560, 1);
end _lmcode_
savedsl(d, "build/pk/draw.dslb");
r = system ${dsl_cli(d)} --lmcode build/pk/draw.dslb;
assert(r.code == 0, r.stdout + r.stderr);

plot = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/showcase-13-bio-dosing-regimen.png", 900, 560);
plot.cmd("set datafile separator ','");
plot.cmd("set label 99 'Same daily dose, different regimen: 400 mg every 12 h stays in the window, 800 mg once a day does not' at screen 0.5, 0.955 center font ',12'");
plot.cmd("set pixmap 1 'build/rendered/pk_model.png' at screen 0.015, 0.05 width screen 0.33");
plot.cmd("set lmargin at screen 0.44; set rmargin at screen 0.97; set tmargin at screen 0.88; set bmargin at screen 0.13");
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#e4e9ef'; set key top right font ',9' box opaque");
plot.cmd("set xlabel 'time (h)'; set ylabel 'plasma concentration (mg/L)'; set xrange [0:96]; set yrange [0:22]; set xtics 12");
plot.cmd("set object 1 rect from 0, 3 to 96, 12 fc rgb '#dcfce7' fs solid 1.0 noborder behind");
plot.cmd("set label 1 'therapeutic window 3-12 mg/L' at 94, 11.2 right font ',9' tc rgb '#166534'");
plot.cmd("css = " + str(${css}) + "; cov12 = " + str(${cov12}) + "; cov24 = " + str(${cov24}));
plot.cmd("set arrow 1 from 0, css to 96, css nohead dt 2 lw 1.5 lc rgb '#334155'");
plot.cmd("set label 2 sprintf('Css,avg = %.1f mg/L (both)', css) at 94, css + 0.9 right font ',9' tc rgb '#334155'");
plot.cmd("set label 3 sprintf('q12: in window %.0f%% of the time', cov12) at 2, 20.6 font ',9' tc rgb '#1d4ed8'");
plot.cmd("set label 4 sprintf('q24: in window %.0f%% of the time', cov24) at 2, 19.2 font ',9' tc rgb '#dc2626'");
plot.cmd("plot for [k=0:7] sprintf('build/pk/q12_%d.csv', k) using 1:3 with lines lw 2.4 lc rgb '#1d4ed8' title (k == 0 ? '400 mg every 12 h' : ''), for [k=0:3] sprintf('build/pk/q24_%d.csv', k) using 1:3 with lines lw 2.4 lc rgb '#dc2626' title (k == 0 ? '800 mg every 24 h' : '')");
plot.close();
end _lmcode_
savedsl(plot, "build/pk/plot.dslb");
r = system ${dsl_cli(plot)} --lmcode build/pk/plot.dslb;
assert(r.code == 0, r.stdout + r.stderr);
println("wrote images/showcase-13-bio-dosing-regimen.png");
