# SPDX-License-Identifier: MIT
# lmphysics measures a cargo block's velocity; the measured acceleration and
# force balance are then passed to lmvideo for a data-driven loading diagram.
mkdir("build/examples"); mkdir("build/rendered"); mkdir("images");
sim = _lmcode_ cli="lmphysics" install="github:lmctl-ai/lmphysics@latest";
let th = 0.41887902047863906;
let w = phys.system("nsc");
w.material("m", 0.3, 0.0).timestep(0.001);
 w.box("ramp", 40.0, 4.0, 0.5, 1000.0).rot_axis(0.0, 1.0, 0.0, th).fixed(true).collide("m");
let blk = w.box("blk", 0.4, 0.4, 0.4, 93.75).pos(0.45 * sin(th), 0.0, 0.45 * cos(th)).rot_axis(0.0, 1.0, 0.0, th).collide("m");
phys.assert_close(blk.mass(), 6.0, 0.000001);
w.record("blk", "vx,vz");
w.run(1.4);
w.save_csv("build/examples/physics.csv");
end _lmcode_
savedsl(sim, "build/physics.dslb");
r = system ${dsl_cli(sim)} --lmcode build/physics.dslb;
assert(r.code == 0, r.stdout + r.stderr);
rows = csv_parse(read_file("build/examples/physics.csv"));
let a0 = rows.get(200, null); let a1 = rows.get(1400, null);
let v0 = a0.get("blk.vx", 0.0) * 0.9135454576426009 - a0.get("blk.vz", 0.0) * 0.4067366430758002;
let v1 = a1.get("blk.vx", 0.0) * 0.9135454576426009 - a1.get("blk.vz", 0.0) * 0.4067366430758002;
let acceleration = (v1 - v0) / 1.2;
let weight = 6.0 * 9.81; let normal = weight * 0.9135454576426009; let downslope = weight * 0.4067366430758002;
let net = 6.0 * acceleration; let friction = downslope - net; let measured_mu = friction / normal;
assert(measured_mu > 0.0 && measured_mu < 1.0);
assert(abs(measured_mu - 0.3) < 0.01);
assert(abs(acceleration - 9.81 * (0.4067366430758002 - 0.3 * 0.9135454576426009)) < 0.02);
let title = sprintf("Measured cargo-ramp forces: a = %.2f m/s2", acceleration);
let subtitle = sprintf("lmphysics collision result: 6 kg cargo, 24 deg ramp; measured effective mu = %.3f", measured_mu);
let accel_label = sprintf("a = net / m = %.2f m/s2", net / 6.0);
let weight_label = sprintf("weight = %.1f N", weight);
let normal_label = sprintf("normal = %.1f N", normal);
let friction_label = sprintf("friction = %.1f N", friction);
let net_label = sprintf("net = %.1f N", net);
let scale = 2.1;
let contact_x = 424.0;
let contact_y = 520.0 - (contact_x - 90.0) * 0.4067366430758002 / 0.9135454576426009;
let center_x = contact_x - 29.0 * 0.4067366430758002;
let center_y = contact_y - 29.0 * 0.9135454576426009;
let block_x = center_x - 44.0;
let block_y = center_y - 29.0;
let block_transform = sprintf("rotate(-24 %.2f %.2f)", center_x, center_y);
let ramp_path = sprintf("M 90 520 L 590 %.2f L 590 520 Z", 520.0 - 500.0 * 0.4067366430758002 / 0.9135454576426009);
let weight_x2 = center_x;
let weight_y2 = center_y + scale * weight;
let normal_x2 = center_x - scale * normal * 0.4067366430758002;
let normal_y2 = center_y - scale * normal * 0.9135454576426009;
let friction_x2 = center_x + scale * friction * 0.9135454576426009;
let friction_y2 = center_y - scale * friction * 0.4067366430758002;
d = _lmcode_ cli="lmvideo" install="github:lmctl-ai/lmvideo@v0.1.36";
let __lmvideo_font_regular = font_load("https://raw.githubusercontent.com/lmctl-ai/lmdraw/7e8623f88b7baef858a405064823c2244fac7420/assets/fonts/NotoSans-Regular.ttf", "478c558ea716033cd60c03438f628dfa75694dcf6b5f6d505a2f05fd2b4f3823");
let __lmvideo_font_bold = font_load("https://raw.githubusercontent.com/lmctl-ai/lmdraw/7e8623f88b7baef858a405064823c2244fac7420/assets/fonts/NotoSans-Bold.ttf", "1df075a380fc7cb898acf64c1f7b3b4dd780de3caa860178bf929de35817a913");
let __lmvideo_font_math = font_load("https://raw.githubusercontent.com/lmctl-ai/lmdraw/ca2f5a635519fcc2200dbdc73a04e7388773dfb7/assets/fonts/NotoSansMath-Regular.ttf", "d51afd5739c7ba6c44fcab35a88160e25dfb69a2d4ad0bd99533f8d894af1f96");
canvas.typeface(__lmvideo_font_regular);
canvas.target(surface(900, 620)); canvas.clear("#0f1720");
canvas.text(40.0, 45.0, 25.0, ${title}, "#e6edf3").set_attr("font-weight", "700");
canvas.text(40.0, 73.0, 14.0, ${subtitle}, "#9fb3c8");
canvas.path(${ramp_path}, "#26384a", "#6f8da8", 3.0);
canvas.rect(${block_x}, ${block_y}, 88.0, 58.0, "#3c82a8").set_attr("transform", ${block_transform});
canvas.arrow(${center_x}, ${center_y}, ${weight_x2}, ${weight_y2}, "#ffd166", 3.5).set_attr("marker-end", "arrow");
canvas.arrow(${center_x}, ${center_y}, ${normal_x2}, ${normal_y2}, "#7bd88f", 3.5).set_attr("marker-end", "arrow");
canvas.arrow(${center_x}, ${center_y}, ${friction_x2}, ${friction_y2}, "#ff6b6b", 3.5).set_attr("marker-end", "arrow");
canvas.text(660.0, 190.0, 18.0, "Force balance", "#e6edf3");
canvas.rect(640.0, 215.0, 220.0, 150.0, "#16222e").set_attr("rx", "8");
canvas.text(660.0, 250.0, 15.0, ${weight_label}, "#c9d6e2");
canvas.text(660.0, 278.0, 15.0, ${normal_label}, "#c9d6e2");
canvas.text(660.0, 306.0, 15.0, ${friction_label}, "#c9d6e2");
canvas.text(660.0, 334.0, 15.0, ${net_label}, "#c9d6e2");
canvas.text(660.0, 410.0, 18.0, ${accel_label}, "#f5c16c");
canvas.text(150.0, 550.0, 15.0, "24 deg cargo ramp; arrows are scaled by measured forces", "#9fb3c8");
canvas.redraw(); canvas.png("build/rendered/physics-free-body.png", 900, 620, 1);
end _lmcode_
savedsl(d, "build/draw.dslb");
r = system ${dsl_cli(d)} --lmcode build/draw.dslb;
assert(r.code == 0, r.stdout + r.stderr);
copy_file("build/rendered/physics-free-body.png", "images/showcase-05-physics-free-body.png");
println("wrote images/showcase-05-physics-free-body.png");
