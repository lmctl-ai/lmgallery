# SPDX-License-Identifier: MIT
# Science report: how well is damping recovered from a simulated oscillator? lmnum integrates a
# damped oscillator x'' + 2 zeta w x' + w^2 x = 0 (w = 2 rad/s) with CVODE for three damping ratios
# (0.05, 0.15, 0.25), finds the positive peaks of x(t), refines the first two by parabolic
# interpolation, and estimates the damping ratio from their logarithmic decrement,
#   delta = ln(x1/x2) = 2 pi zeta / sqrt(1 - zeta^2),   so   zeta = delta / sqrt(delta^2 + 4 pi^2).
# lmvideo draws the measured against the set damping ratio, with the identity line. lmoffice
# writes the report: method, results table, figure and conclusion. The program asserts that every
# measured ratio is within 1 % of the value used in the simulation.
mkdir("images");
mkdir("build");

sim = _lmcode_ cli="lmnum" install="github:lmctl-ai/lmnum@latest";
let two_pi = 6.283185307179586;
for (k in range(0, 3)) {
  let zeta = 0.05 + 0.1 * float(k);
  let sys = num.ode(2);
  sys.param("w", 2.0).param("zeta", zeta);
  sys.rhs(0, "y1");
  sys.rhs(1, "-w*w*y0 - 2.0*zeta*w*y1");
  sys.init(0, 1.0).init(1, 0.0);
  sys.tol(0.0000001, 0.00000001);
  let sol = sys.solve(0.0, 20.0, 8001);
  let p1 = 0.0;
  let p2 = 0.0;
  let found = 0;
  for (i in range(1, 8000)) {
    let xm = sol.get(i - 1, 1);
    let x0 = sol.get(i, 1);
    let xp = sol.get(i + 1, 1);
    if (x0 > 0.0 && x0 > xm && x0 >= xp) {
      let peak = x0 - (xp - xm) * (xp - xm) / (8.0 * (xp - 2.0 * x0 + xm));
      if (found == 0) { p1 = peak; found = 1; }
      else { if (found == 1) { p2 = peak; found = 2; } }
    }
  }
  let delta = num.eval("log(" + str(p1 / p2) + ")");
  let zeta_est = delta / sqrt(delta * delta + two_pi * two_pi);
  num.print("z" + str(k) + "_true=" + str(zeta));
  num.print("z" + str(k) + "_est=" + str(zeta_est));
  num.assert_close(zeta_est, zeta, 0.01 * zeta);
}
end _lmcode_
savedsl(sim, "build/damping-sim.dslb");
r = system(concat(dsl_cli(sim), ["--dsl", "build/damping-sim.dslb"]), 600000);
assert(r.code == 0, r.stdout + r.stderr);

# Read the simulated and measured ratios back from the lmnum output lines.
let t0 = 0.0;
let t1 = 0.0;
let t2 = 0.0;
let e0 = 0.0;
let e1 = 0.0;
let e2 = 0.0;
for (line in split(r.stdout, "\n")) {
  let parts = split(line, "=");
  if (starts_with(line, "z0_true=")) { t0 = num(parts[1]); }
  if (starts_with(line, "z0_est=")) { e0 = num(parts[1]); }
  if (starts_with(line, "z1_true=")) { t1 = num(parts[1]); }
  if (starts_with(line, "z1_est=")) { e1 = num(parts[1]); }
  if (starts_with(line, "z2_true=")) { t2 = num(parts[1]); }
  if (starts_with(line, "z2_est=")) { e2 = num(parts[1]); }
}

# Figure (lmvideo): measured against set damping ratio, with the identity line.
figure = _lmcode_ cli="lmvideo" install="github:lmctl-ai/lmvideo@v0.1.36";
video.size(900, 480); video.frames(1); video.output("images/showcase-31-science-report.png"); video.begin();
video.frame();
canvas.clear("#ffffff");
let fig = canvas.panel(12.0, 12.0, 876.0, 456.0).manager("box_v").padding(10.0, 10.0, 10.0, 10.0).gap(6.0).background("#ffffff");
let plot = fig.add_plot().weight(1.0).fill("both").plot().title("Damping ratio recovered from simulated peaks (lmnum)").xlabel("set damping ratio zeta").ylabel("measured damping ratio").x_range(0.0, 0.3).y_range(0.0, 0.3).legend("top_left").background("#ffffff");
let identity = plot.series("identity", "line", "#94a3b8").width(1.5);
identity.add(0.0, 0.0); identity.add(0.3, 0.3);
let measured = plot.series("measured", "scatter", "#1F4E78").marker("circle");
measured.add(${t0}, ${e0}); measured.add(${t1}, ${e1}); measured.add(${t2}, ${e2});
fig.draw();
video.end();
end _lmcode_
savedsl(figure, "build/damping-figure.dslb");
r = system(concat(dsl_cli(figure), ["--dsl", "build/damping-figure.dslb"]), 300000);
assert(r.code == 0, r.stdout + r.stderr);

# Report (lmoffice).
report = _lmcode_ cli="lmoffice docx" install="github:lmctl-ai/lmoffice@v0.1.29";
let doc = docx.create("build/damping-report.docx");
doc.title("Recovering damping from a simulated oscillator").author("Simulation group");
doc.heading("Recovering damping from a simulated oscillator", 1).bold(true);
doc.heading("Method", 2);
doc.paragraph("A damped oscillator with natural frequency 2 rad/s was integrated with lmnum (CVODE, relative tolerance 1e-7) for 20 s at three damping ratios. The first two positive peaks of the displacement were refined by parabolic interpolation, and the damping ratio was estimated from their logarithmic decrement.");
doc.heading("Results", 2);
let table = doc.table(4, 3);
table.cell(1, 1, "Set damping ratio").cell(1, 2, "Measured damping ratio").cell(1, 3, "Relative error");
table.cell(2, 1, "0.05").cell(2, 2, ${str(round(e0 * 100000.0) / 100000.0)}).cell(2, 3, ${str(round(abs(e0 - t0) / t0 * 1000000.0) / 10000.0)} + " %");
table.cell(3, 1, "0.15").cell(3, 2, ${str(round(e1 * 100000.0) / 100000.0)}).cell(3, 3, ${str(round(abs(e1 - t1) / t1 * 1000000.0) / 10000.0)} + " %");
table.cell(4, 1, "0.25").cell(4, 2, ${str(round(e2 * 100000.0) / 100000.0)}).cell(4, 3, ${str(round(abs(e2 - t2) / t2 * 1000000.0) / 10000.0)} + " %");
doc.image("images/showcase-31-science-report.png", 600, 320);
doc.heading("Conclusion", 2);
doc.paragraph("The logarithmic decrement recovers each set damping ratio to better than 1 %, so the peak method is accurate enough for the damping estimates used in the lmnum examples.");
doc.save();
end _lmcode_
savedsl(report, "build/damping-report.dslb");
r = system(concat(dsl_cli(report), ["--dsl", "build/damping-report.dslb"]), 300000);
assert(r.code == 0, r.stdout + r.stderr);
println("wrote build/damping-report.docx and images/showcase-31-science-report.png");
