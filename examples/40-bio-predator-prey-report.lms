# SPDX-License-Identifier: MIT
# Predator-prey lab report. lmbio builds the coupled prey and predator model used in the lmbio
# examples (birth, predation, predator death as mass-action reactions), simulates it for 20 time
# units with 401 output points, and reports the peak prey and predator populations and the final
# state. The program checks that the populations stay positive and that predators peak after prey.
# lmvideo draws the two trajectories from twelve samples of the run as a PNG (the gallery
# output, 900 px wide); lmoffice (Open XML) writes the lab report: method, results table, figure,
# and conclusion.
mkdir("images");
mkdir("build");

sim = _lmcode_ cli="lmbio" install="github:lmctl-ai/lmbio@v0.1.3";
let m = bio.model("ecology").compartment("v", 1.0).species("prey", "v", 10.0).species("pred", "v", 5.0).reaction("birth", "prey -> 2 prey", "prey").reaction("hunt", "prey + pred -> 2 pred", "0.1*prey*pred").reaction("death", "pred ->", "pred");
let r = m.simulate(0.0, 20.0, 401);
bio.assert_true(r.final("prey") > 0.0);
bio.assert_true(r.final("pred") > 0.0);
bio.print("prey_peak=" + str(r.max("prey")));
bio.print("pred_peak=" + str(r.max("pred")));
bio.print("prey_peak_time=" + str(r.time_of_max("prey")));
bio.print("pred_peak_time=" + str(r.time_of_max("pred")));
bio.print("prey_final=" + str(r.final("prey")));
bio.print("pred_final=" + str(r.final("pred")));
bio.print("p0=" + str(r.value("prey", 0)));
bio.print("q0=" + str(r.value("pred", 0)));
bio.print("p1=" + str(r.value("prey", 36)));
bio.print("q1=" + str(r.value("pred", 36)));
bio.print("p2=" + str(r.value("prey", 72)));
bio.print("q2=" + str(r.value("pred", 72)));
bio.print("p3=" + str(r.value("prey", 108)));
bio.print("q3=" + str(r.value("pred", 108)));
bio.print("p4=" + str(r.value("prey", 144)));
bio.print("q4=" + str(r.value("pred", 144)));
bio.print("p5=" + str(r.value("prey", 180)));
bio.print("q5=" + str(r.value("pred", 180)));
bio.print("p6=" + str(r.value("prey", 216)));
bio.print("q6=" + str(r.value("pred", 216)));
bio.print("p7=" + str(r.value("prey", 252)));
bio.print("q7=" + str(r.value("pred", 252)));
bio.print("p8=" + str(r.value("prey", 288)));
bio.print("q8=" + str(r.value("pred", 288)));
bio.print("p9=" + str(r.value("prey", 324)));
bio.print("q9=" + str(r.value("pred", 324)));
bio.print("p10=" + str(r.value("prey", 360)));
bio.print("q10=" + str(r.value("pred", 360)));
bio.print("p11=" + str(r.value("prey", 396)));
bio.print("q11=" + str(r.value("pred", 396)));
r.save_csv("build/predator-prey.csv");
end _lmcode_
savedsl(sim, "build/predator-prey-sim.dslb");
r = system(concat(dsl_cli(sim), ["--dsl", "build/predator-prey-sim.dslb"]), 300000);
assert(r.code == 0, r.stdout + r.stderr);

# Read the results back.
let prey_peak = 0.0; let pred_peak = 0.0; let prey_peak_t = 0.0; let pred_peak_t = 0.0; let prey_final = 0.0; let pred_final = 0.0;
let p0 = 0.0; let q0 = 0.0;
let p1 = 0.0; let q1 = 0.0;
let p2 = 0.0; let q2 = 0.0;
let p3 = 0.0; let q3 = 0.0;
let p4 = 0.0; let q4 = 0.0;
let p5 = 0.0; let q5 = 0.0;
let p6 = 0.0; let q6 = 0.0;
let p7 = 0.0; let q7 = 0.0;
let p8 = 0.0; let q8 = 0.0;
let p9 = 0.0; let q9 = 0.0;
let p10 = 0.0; let q10 = 0.0;
let p11 = 0.0; let q11 = 0.0;
for (line in split(r.stdout, "\n")) {
  let parts = split(line, "=");
  if (starts_with(line, "prey_peak=")) { prey_peak = num(parts[1]); }
  if (starts_with(line, "pred_peak=")) { pred_peak = num(parts[1]); }
  if (starts_with(line, "prey_peak_time=")) { prey_peak_t = num(parts[1]); }
  if (starts_with(line, "pred_peak_time=")) { pred_peak_t = num(parts[1]); }
  if (starts_with(line, "prey_final=")) { prey_final = num(parts[1]); }
  if (starts_with(line, "pred_final=")) { pred_final = num(parts[1]); }
  if (starts_with(line, "p0=")) { p0 = num(parts[1]); }
  if (starts_with(line, "q0=")) { q0 = num(parts[1]); }
  if (starts_with(line, "p1=")) { p1 = num(parts[1]); }
  if (starts_with(line, "q1=")) { q1 = num(parts[1]); }
  if (starts_with(line, "p2=")) { p2 = num(parts[1]); }
  if (starts_with(line, "q2=")) { q2 = num(parts[1]); }
  if (starts_with(line, "p3=")) { p3 = num(parts[1]); }
  if (starts_with(line, "q3=")) { q3 = num(parts[1]); }
  if (starts_with(line, "p4=")) { p4 = num(parts[1]); }
  if (starts_with(line, "q4=")) { q4 = num(parts[1]); }
  if (starts_with(line, "p5=")) { p5 = num(parts[1]); }
  if (starts_with(line, "q5=")) { q5 = num(parts[1]); }
  if (starts_with(line, "p6=")) { p6 = num(parts[1]); }
  if (starts_with(line, "q6=")) { q6 = num(parts[1]); }
  if (starts_with(line, "p7=")) { p7 = num(parts[1]); }
  if (starts_with(line, "q7=")) { q7 = num(parts[1]); }
  if (starts_with(line, "p8=")) { p8 = num(parts[1]); }
  if (starts_with(line, "q8=")) { q8 = num(parts[1]); }
  if (starts_with(line, "p9=")) { p9 = num(parts[1]); }
  if (starts_with(line, "q9=")) { q9 = num(parts[1]); }
  if (starts_with(line, "p10=")) { p10 = num(parts[1]); }
  if (starts_with(line, "q10=")) { q10 = num(parts[1]); }
  if (starts_with(line, "p11=")) { p11 = num(parts[1]); }
  if (starts_with(line, "q11=")) { q11 = num(parts[1]); }
}
assert(prey_peak > 10.0);
assert(pred_peak > 5.0);
assert(pred_peak_t > prey_peak_t);

# Figure (lmvideo): the two trajectories from twelve samples of the run.
figure = _lmcode_ cli="lmvideo" install="github:lmctl-ai/lmvideo@v0.1.28";
video.size(900, 480); video.frames(1); video.output("images/showcase-40-predator-prey.png"); video.begin();
video.frame();
canvas.clear("#ffffff");
let fig = canvas.panel(12.0, 12.0, 876.0, 456.0).manager("box_v").padding(10.0, 10.0, 10.0, 10.0).gap(6.0).background("#ffffff");
let plot = fig.add_plot().weight(1.0).fill("both").plot().title("Predator-prey model: 12 samples of the lmbio run").xlabel("time").ylabel("population").x_range(0.0, 20.0).y_range(0.0, 25.0).legend("top_right").background("#ffffff");
let prey = plot.series("prey", "line", "#2E75B6").width(3.0).marker("circle");
let pred = plot.series("predators", "line", "#df6b38").width(3.0).marker("circle");
prey.add(0.0, ${p0 + 0.000000001}); pred.add(0.0, ${q0 + 0.000000001});
prey.add(1.8, ${p1 + 0.000000001}); pred.add(1.8, ${q1 + 0.000000001});
prey.add(3.6, ${p2 + 0.000000001}); pred.add(3.6, ${q2 + 0.000000001});
prey.add(5.4, ${p3 + 0.000000001}); pred.add(5.4, ${q3 + 0.000000001});
prey.add(7.2, ${p4 + 0.000000001}); pred.add(7.2, ${q4 + 0.000000001});
prey.add(9.0, ${p5 + 0.000000001}); pred.add(9.0, ${q5 + 0.000000001});
prey.add(10.8, ${p6 + 0.000000001}); pred.add(10.8, ${q6 + 0.000000001});
prey.add(12.6, ${p7 + 0.000000001}); pred.add(12.6, ${q7 + 0.000000001});
prey.add(14.4, ${p8 + 0.000000001}); pred.add(14.4, ${q8 + 0.000000001});
prey.add(16.2, ${p9 + 0.000000001}); pred.add(16.2, ${q9 + 0.000000001});
prey.add(18.0, ${p10 + 0.000000001}); pred.add(18.0, ${q10 + 0.000000001});
prey.add(19.8, ${p11 + 0.000000001}); pred.add(19.8, ${q11 + 0.000000001});
fig.draw();
video.end();
end _lmcode_
savedsl(figure, "build/predator-prey-figure.dslb");
r = system(concat(dsl_cli(figure), ["--dsl", "build/predator-prey-figure.dslb"]), 300000);
assert(r.code == 0, r.stdout + r.stderr);

# Lab report (lmoffice).
report = _lmcode_ cli="lmoffice docx" install="github:lmctl-ai/lmoffice@v0.1.29";
let doc = docx.create("build/predator-prey-lab-report.docx");
doc.title("Predator-prey lab report").author("Systems biology group");
doc.heading("Predator-prey lab report", 1).bold(true);
doc.heading("Method", 2);
doc.paragraph("Prey grow by birth, predators grow by predation (rate 0.1 per prey and predator), and predators die at unit rate. Starting populations are 10 prey and 5 predators. The model was simulated with lmbio for 20 time units, 401 output points.");
doc.heading("Results", 2);
let t = doc.table(3, 3);
t.cell(1, 1, "Quantity").cell(1, 2, "Prey").cell(1, 3, "Predators");
t.cell(2, 1, "Peak population").cell(2, 2, ${str(round(prey_peak * 100.0) / 100.0)}).cell(2, 3, ${str(round(pred_peak * 100.0) / 100.0)});
t.cell(3, 1, "Final population (t = 20)").cell(3, 2, ${str(round(prey_final * 100.0) / 100.0)}).cell(3, 3, ${str(round(pred_final * 100.0) / 100.0)});
doc.image("images/showcase-40-predator-prey.png", 600, 320);
doc.heading("Conclusion", 2);
doc.paragraph("Predators peak after prey, as the coupled model predicts. The populations stay positive throughout the run.");
doc.save();
end _lmcode_
savedsl(report, "build/predator-prey-report.dslb");
r = system(concat(dsl_cli(report), ["--dsl", "build/predator-prey-report.dslb"]), 300000);
assert(r.code == 0, r.stdout + r.stderr);
println("wrote build/predator-prey-lab-report.docx and images/showcase-40-predator-prey.png");
