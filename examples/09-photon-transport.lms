# SPDX-License-Identifier: MIT
# Photon transport through water: the released lmparticle API computes the
# uncollided fraction after four slab thicknesses; lmplot renders those measured
# Monte Carlo results against the exponential attenuation law.
mkdir("build/particle");
compute = _dsl_ cli="lmparticle" install="github:lmctl-ai/lmparticle@latest";
let water = rad.builtin("water");
for (i in range(0, 4)) {
  let thickness = 1.0 * pow(2.0, float(i));
  let geometry = rad.geometry().slab("water", water, 0.0, thickness);
  let source = rad.source().point(0.0, 0.0, -1.0).beam(0.0, 0.0, 1.0).energy(0.662);
  let result = rad.simulation(geometry, source).plane("exit", "z", thickness).seed(9090 + i).run(20000);
  let measured = result.plane_uncollided("exit");
  let expected = pow(2.718281828459045, -water.mu(0.662) * thickness);
  let se = result.plane_uncollided_err("exit");
  rad.assert_true(se > 0.0 && se < 0.02);
  rad.assert_close(measured, expected, 5.0 * se + 0.0001);
  rad.print("row," + str(thickness) + "," + str(measured) + "," + str(expected) + "," + str(se));
}
end _dsl_
savedsl(compute, "build/particle/compute.dslb");
r = system ${dsl_cli(compute)} --dsl build/particle/compute.dslb;
assert(r.code == 0, r.stdout + r.stderr);
let csv = "thickness,measured,exponential,standard_error\n";
for (line in split(r.stdout, "\n")) { if (starts_with(line, "row,")) { csv = csv + substr(line, 4) + "\n"; } }
write_file("build/particle/attenuation.csv", csv);
mkdir("images");
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/showcase-09-photon-transport.png", 900, 560);
plot.cmd("set datafile separator ','; set title 'Photon transport through water at 662 keV'; set xlabel 'Water thickness (cm)'; set ylabel 'Uncollided fraction'; set xrange [0:9]; set yrange [0.4:1.02]; set grid back lc rgb '#e4e9ef'; set key bottom left");
plot.cmd("plot 'build/particle/attenuation.csv' using 1:2:4 with yerrorbars pt 7 ps 1.2 lw 1.5 lc rgb '#2c7bb6' title 'Monte Carlo +/- 1 standard error', 'build/particle/attenuation.csv' using 1:3 with lines lw 2 lc rgb '#d7191d' title 'exp(-mu x)'");
plot.close();
end _dsl_
savedsl(plot, "build/particle/draw.dslb");
r = system ${dsl_cli(plot)} --dsl build/particle/draw.dslb;
assert(r.code == 0, r.stdout + r.stderr);
println("wrote images/showcase-09-photon-transport.png");
